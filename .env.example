# Copy to .env and fill in. Never commit .env — it is git-ignored.
# Anything without a VITE_ prefix stays on the server and never reaches the browser bundle.

# --- API ---
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:5173

# --- Azure Document Intelligence (Task 07) ---
# Server-only. Must never gain a VITE_ prefix.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# --- Supabase / database (Task 03) ---
# Supabase issues these as "publishable" and "secret"; they replace the older
# anon / service_role key pair. SUPABASE_SECRET_KEY bypasses Row Level Security,
# so it is server-only and must never gain a VITE_ prefix.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Required value: receipt-sources
STORAGE_BUCKET=

# --- Uploads (Task 05) ---
# Defaults: 10485760 bytes (10 MB) and 10 PDF pages.
MAX_UPLOAD_BYTES=
MAX_PDF_PAGES=

# Used by the Supabase CLI to push migrations, not by the API at runtime.
DATABASE_URL=

# --- Client (browser) ---
# Only VITE_-prefixed variables reach the browser bundle. The publishable key is designed to be
# public: it is the successor to the anon key, it is what Row Level Security assumes the browser
# holds, and on its own it grants nothing — every request is still scoped by the user's own token.
# The secret key above must never gain this prefix.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
